# 安装 & 加载必要包
if (!requireNamespace("BiocManager", quietly = TRUE))
install.packages("BiocManager")
packages <- c("openxlsx", "tidyverse", "lefser", "SummarizedExperiment")
for (pkg in packages) {
if (!requireNamespace(pkg, quietly = TRUE))
BiocManager::install(pkg)
library(pkg, character.only = TRUE)
}
# 读取 KEGG 丰度表
abundance_df <- read.xlsx("KEGG.level3.abundance.xlsx")
rownames(abundance_df) <- abundance_df[, 1]
abundance_df <- abundance_df[, -1]  # 去除第一列 SampleID
# 读取分组信息
meta_raw <- read.xlsx("Group.xlsx")
rownames(meta_raw) <- meta_raw$SampleID
meta_df <- data.frame(Group = as.factor(meta_raw$Group))
rownames(meta_df) <- meta_raw$SampleID
# 构建 SummarizedExperiment 对象
abundance_mat <- as.matrix(abundance_df)
# 检查样本是否匹配
if (!all(colnames(abundance_mat) == rownames(meta_df))) {
stop("样本名不匹配，请检查 abundance 表和分组信息。")
}
se <- SummarizedExperiment(
assays = SimpleList(exprs = abundance_mat),
colData = meta_df
)
# 保存 RDS（可选）
saveRDS(se, file = "lefsedata_se.rds")
# 转换为相对丰度
se <- relativeAb(se)
# 运行 lefser 分析
set.seed(1234)
res <- lefser(se, classCol = "Group")
# 输出前几行
print(head(res))
# 保存结果
write.xlsx(as.data.frame(res), file = "lefse_results.xlsx", rowNames = TRUE)
p <- lefserPlot(res)
print(p)
library(ggplot2)
library(dplyr)
# 假设 res 是你 lefser 函数返回的结果
lda_df <- as.data.frame(res)
# 统一列名，方便写代码
colnames(lda_df)[colnames(lda_df) == "features"] <- "Feature"
colnames(lda_df)[colnames(lda_df) == "scores"] <- "LDA"
# 为了演示，根据 LDA 正负自动判断分组
lda_df$Group <- ifelse(lda_df$LDA > 0, "Group_AN", "Group_HC")
# 计算标签偏移量（手动微调文本位置）
offset <- 0.1 * max(abs(lda_df$LDA))
# 获取 x 轴刻度位置，用于画纵向实线
x_breaks <- pretty(lda_df$LDA, n = 5)
# 纵向范围
min_y <- 1
max_y <- nrow(lda_df)
# 纵向线段绘制位置：在图中间偏下的区域
line_min_y <- min_y + (max_y - min_y) * 0.4
line_max_y <- min_y + (max_y - min_y) * 0.6
lda_df <- lda_df %>%
arrange(desc(LDA)) %>%
mutate(Feature = factor(Feature, levels = rev(Feature)))
# 作图
p <- ggplot(lda_df, aes(x = LDA, y = Feature, fill = Group)) +
# 柱状图，黑边框
geom_col(width = 0.7, color = "black", linewidth = 0.9) +
# x=0 竖线
geom_vline(xintercept = 0, color = "black") +
# 特征名标签，x 轴两侧偏移
geom_text(aes(label = Feature,
x = ifelse(LDA < 0, 0 + offset, 0 - offset)),
hjust = ifelse(lda_df$LDA < 0, 0, 1),
color = "black", size = 4) +
# 纵向实线，辅助视觉
lapply(x_breaks, function(x) {
geom_segment(x = x, xend = x, y = line_min_y, yend = line_max_y,
color = "black", linetype = "solid", linewidth = 0.7)
}) +
# 分组颜色自定义
scale_fill_manual(values = c("Group_HC" = "lightgreen", "Group_AN" = "orchid"),
name = "Group") +
# 主题与标签
labs(x = "LDA SCORE (log10)", y = NULL) +
theme_classic() +
theme(
axis.line.x = element_blank(),
axis.line.y = element_blank(),
axis.text.y = element_blank(),  # 不显示默认 y 轴标签（用手动 geom_text 代替）
legend.position = c(0.1, 1),
legend.direction = "horizontal",
legend.justification = "left",
plot.title = element_text(hjust = 0.5),
axis.text = element_text(size = 12)
)
print(p)
